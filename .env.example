# After cloning the repository:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Edit .env with your actual credentials
# CAUTION: Never commit .env to version control!!!
#
# Note: This file is safe to commit as it contains only placeholder values

# Application Secret Key (generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))')
APP_SECRET_KEY=your_app_secret_key_here

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PASS=your_db_password_here
DB_PORT=5432
DB_NAME=snaarf_app
DB_URI="postgresql:///snaarf_app"
DB_USER=snaarf_app

# Development Server Configuration
DEV_HOST=localhost
DEV_PORT=8000

# Redis Configuration
REDIS_AUTH_PASSWORD=your_redis_password_here
REDIS_HOST=localhost
REDIS_PORT=6379

# Twitch API Configuration
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_REDIRECT_URI=http://localhost:8000/twitch/auth_redirect
TWITCH_SECRET=your_twitch_secret_here
